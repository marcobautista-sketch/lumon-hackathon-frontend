# Copia este archivo a ".env" (sin ".example") para correr en local.
# El .env real no se sube a git; cada integrante del equipo crea el suyo.
VITE_API_BASE_URL=https://lumon-api.vercel.app/api/v1
VITE_WS_BASE_URL=wss://lumon-api.vercel.app/api/v1

# Storage de imágenes (Cloudinary, CP4). Solo valores públicos: NUNCA el API secret.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
